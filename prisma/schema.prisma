datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------
// Auth.js (NextAuth) Models
// -------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  
  // Custom Relation
  patients      Patient[] // A doctor can be assigned multiple patients
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------
// Application Models
// -------------------------------------

model Patient {
  id          Int      @id @default(autoincrement())
  name        String
  age         Int
  status      String   // "Critical", "Stable", "Review"
  summary     String   @db.Text
  
  // A patient belongs to a specific doctor (User) to enforce multi-tenancy later
  doctorId    String?
  doctor      User?     @relation(fields: [doctorId], references: [id])
  
  documents   Document[]
  vitalReadings VitalReading[]
  images      MedicalImage[]
  clinicalNotes ClinicalNote[]
  trialMatches TrialMatch[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  fileName    String
  
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model VitalReading {
  id          String   @id @default(cuid())
  
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  systolic    Int
  diastolic   Int
  heartRate   Int?
  spo2        Int?     // Oxygen saturation %
  recordedAt  DateTime @default(now())

  @@index([patientId, recordedAt])
}

model MedicalImage {
  id             String    @id @default(cuid())
  
  patientId      Int
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  fileName       String
  title          String
  imageUrl       String    @db.Text
  imageType      String    // "X-Ray", "ECG", "CT Scan", "Lab Report", "Ultrasound"
  clinicalNotes  String?   @db.Text
  aiImpression   String?   @db.Text
  modalityDetail String?   // e.g. "PA / Lateral Projection", "Standard 12-Lead"
  
  createdAt      DateTime  @default(now())

  @@index([patientId, createdAt])
}

model ClinicalNote {
  id             String   @id @default(cuid())
  patientId      Int
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title          String
  noteType       String   @default("SOAP")
  subjective     String   @db.Text
  objective      String   @db.Text
  assessment     String   @db.Text
  plan           String   @db.Text
  rawTranscript  String?  @db.Text
  dictatedBy     String?
  signedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId, createdAt])
}

model ClinicalTrial {
  id                String       @id // e.g. "NCT-05189241"
  title             String
  phase             String       // "Phase I", "Phase II", "Phase III", "Early Access"
  condition         String
  sponsor           String
  status            String       @default("Recruiting") // "Recruiting", "Active", "Completed"
  summary           String       @db.Text
  inclusionCriteria String[]
  exclusionCriteria String[]
  targetBiomarkers  String[]
  trialMatches      TrialMatch[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model TrialMatch {
  id                  String        @id @default(cuid())
  patientId           Int
  patient             Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  trialId             String
  trial               ClinicalTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  matchScore          Int           // 0 to 100%
  status              String        @default("Candidate") // "Eligible", "Candidate", "Ineligible", "Enrolled"
  matchedInclusions   String[]
  unmatchedInclusions String[]
  exclusionFlags      String[]
  aiRationale         String        @db.Text
  evaluatedAt         DateTime      @default(now())

  @@unique([patientId, trialId])
  @@index([patientId, matchScore])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  userEmail    String?
  patientId    Int?
  action       String   // "VIEW_RECORD", "AI_COPILOT_QUERY", "SCRIBE_SOAP_COMMIT", "TRIAL_ENROLLMENT", "VISION_INSPECTION", "FHIR_EXPORT"
  resourceType String   // "Patient", "Document", "VitalReading", "MedicalImage", "ClinicalNote", "TrialMatch", "FHIRBundle"
  resourceId   String?
  details      String?  @db.Text
  ipAddress    String?  @default("127.0.0.1")
  userAgent    String?  @default("MedIntel-EHR-Client/1.0")
  timestamp    DateTime @default(now())

  @@index([patientId, timestamp])
  @@index([action, timestamp])
}
